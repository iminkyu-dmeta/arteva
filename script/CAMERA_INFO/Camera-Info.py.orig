    user = conf["adminuser"]

    desc, rows = db.select_sql(arsql.COUNT_BROADCAST_INFO_SQL)

    if int(rows[0]) > 0:
        desc, rows = db.select_sql(arsql.SELECT_FULL_BROADCAST_SQL, fetchall=True)
        display_select(desc, rows)
        exit(1)

