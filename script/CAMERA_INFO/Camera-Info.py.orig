    else:
        print("register broadcast server(extern)")
        sys.exit(0)

    select_broadcast_info(db)


def delete_broadcast_info(db):
    '''
    '''
    desc, rows = db.select_sql(arsql.SELECT_FULL_BROADCAST_SQL, fetchall=True)

    for row in rows:
        print("Delete Broadcast Text: %s" % row[1])
        db.delete_sql(arsql.DEL_BROADCAST_INFO_SQL.format(row[0]))

    db.delete_sql(arsql.ALTER_BROADCAST_INFO_AUTO_INCREMENT)

    select_broadcast_info(db)


def update_broadcast_info(db, status):
    if status == 'A':
        srh = 'S'
    elif status == 'S':
        srh = 'A'

    desc, rows = db.select_sql(arsql.SELECT_BROADCAST_STATUS.format(srh), fetchall=True)
    if rows:
        for row in rows:
            db.insert_args_sql(arsql.UPDATE_BROADCAST_ACTIVE.format(status, row[0]))

def select_broadcast_info(db):
    desc, rows = db.select_sql(arsql.SELECT_FULL_BROADCAST_SQL, fetchall=True)
    display_select(desc, rows)


def display_select(desc, rows):
    ## read description and print Field name, size
    kv = {}
    lines = []
    pstr = []
    lows = ""

    for dc in desc:
        kv[dc[0].upper()] = len(dc[0])

    for rw in rows:
        for i, k in enumerate(kv.keys()) :
            if len(str(rw[i])) > kv[k] :
                kv[k] = len(str(rw[i]))

    for k, v in kv.items():
        pstr.append('+')
        s = '-'.rjust(v+2, '-')
        pstr.append(s)

        lows += "| %-" + str(v+1) + "s"

    pst = ''.join(pstr) + '+'
    low = lows + '|'

    lines.append(pst)
    lines.append(low % tuple(kv.keys()))
    lines.append(pst)

    for r in rows:
        lines.append(low % tuple(r))
    lines.append(pst)

    for l in lines:
        print(l)


def tupletodict(desc, rows):
    data = []
    de = []
    for d in desc:
        de.append(d[0])

    for r in rows:
        row = {}
        for i, d in enumerate(de):
            row[de[i]] = r[i]

        data.append(row)

    return de, data


def tupletolist(desc, rows):
    data = []
    de = []
    for dc in desc:
        de.append(dc[0])

    data.append(de)
    
    for row in rows:
        data.append(list(row))

    return data


def check_korean(kstr):
    p = re.compile('[ㄱ-힣]')
    r = p.search(kstr)
    if r is None:
        return False
    else:
        return True


def main():
    if len(sys.argv) < 1 :
        print("python3 Camera_Info.py [get|set]")
        sys.exit(1)

    try:
        job = sys.argv[1]
        work = sys.argv[2]
        #cameraname = sys.argv[3]
    except IndexError:
        print("Not read file")

    properties = configparser.ConfigParser()
    properties.read('camera-info.ini')
    conf = properties["default"]

    ims_db = ims_connect_db(conf)

    filename = os.path.join('.', 'CCTV', 'CCTV.csv')

    #hostname = "YS-VDOAN-1"
    hostname = socket.gethostname()
    stationid = conf[hostname]

    #if job == 'hid':
    #    hd = read_cctv_csv_data(filename, conf)
    #    #select_ims_v_camera_info_ex(db)
    #    insert_ims_v_camera_info_ex(ims_db, hd)

    if job == 'get':
        ims_de, ims_data = select_camera_info_ex(ims_db, conf, 'w')
        select_camera_info_ex_station(ims_db, conf, 'w')

    elif job == 'add':
        ims_de, ims_data = select_camera_info_ex(ims_db, conf, "add")
        hd = read_cctv_csv_data(filename, conf)
        insert_rows = prefare_t_arteva_camera_info(ims_de, ims_data, conf)

        db = connect_db(conf, hostname)
        insert_t_arteva_camera_info(db, insert_rows, conf, stationid)

    elif job == 'chk':
        ims_de, ims_data = select_camera_info_ex(ims_db, conf)

        hd = read_cctv_csv_data(filename, conf)

        update_rows = check_t_arteva_camera_info(ims_de, ims_data, conf)

        if update_rows and update_rows.get(stationid):
            db = connect_db(conf, hostname)
            update = update_rows.get(stationid)
            result = update_camera_info(db, conf, update)

            if result:
                write_cctv_csv_data(filename, conf, update_rows)
                select_camera_info_ex(ims_db, conf, 'w')
                for key in update_rows.keys():
                    select_camera_info_ex_stationid(ims_db, conf, key, 'w')

        else:
            print("Same")

    elif job == "del":
        db = connect_db(conf, hostname)
        delete_camera_info(db)

    elif job == "sel":
        db = connect_db(conf, hostname)
        select_camera_info(db)

    elif job == "act":
        db = connect_db(conf, hostname)
        act_camera_info(db, 'A')

    elif job == "sby":
        db = connect_db(conf, hostname)
        act_camera_info(db, 'S')

    #select_db(db)

if __name__=='__main__':
    main()
