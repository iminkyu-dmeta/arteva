def insert_ims_v_camera_info_ex(db, hd):
    ## cct_csv_all_data
    ## 0.카메라교유번호, 1.역사명, 2.역사아이디, 3.카메라명, 4.카메라아이피, 5. NVR RTSP주소, 6.Port, 7.UUID,
    ## 8.채널번호, 9.ID, 10.PW, 11.TYPE, 12.용도,

    desc = db.select_sql(arsql.SELECT_CAMERA_INFO_EX_SQL)

    column = []
    print("Test Camera info insert start : ims_v2 v_camera_info_ex")
    for row in cctv_csv_all_data:
        '''
        insert v_camera_info_ex  
        (카메라고유번호, 역사명, 역사아이디, 카메라명, 카메라아이피, NVR RTSP주소, 제조사명, 모델명, 장애상태코드)
        '''
        start = row['NVR RTSP주소'].find(row['ID'])
        end = row['NVR RTSP주소'].find(row['카메라아이피'])

        if start > 0 and end > 0:
            nvr_url = row['NVR RTSP주소'][:start] + row['NVR RTSP주소'][end:]
            row['NVR RTSP주소'] = nvr_url

        print("CCTV 추가: {} {}".format(row['카메라고유번호'], row['NVR RTSP주소']))
        column = []
        for de in desc:
            try:
                for d in de:
                    match_c = [h for h in hd if h == d[0]]
                    if match_c:
                        column.append(row[match_c[0]])
            except TypeError:
                # None iterable
                pass

        print(arsql.INSERT_CAMERA_INFO_EX_SQL)
        print(tuple(column))
        db.insert_args_sql(arsql.INSERT_CAMERA_INFO_EX_SQL, tuple(column))

    select_ims_v_camera_info_ex(db)


def select_camera_info_ex(db, conf, job=None):
    ## 화상Interface Camera Information (mariadb)  
    ## Daatabase: ims_v2
    ## Table : v_camera_info_ex
    ## (카메라고유번호, 역사명, 역사아이디, 카메라명, 카메라아이피, NVR RTSP주소, 제조사명, 모델명, 장애상태코드)

    desc, rows = db.select_sql(arsql.SELECT_CAMERA_INFO_EX_SQL, fetchall=True)

    de, data = tupletodict(desc, rows)
    #data = tupletolist(desc, rows)

    if job == 'w':
        filename = os.path.join('.', conf["cctvdir"], conf["cctvfile"])
        write_camera_info_ex(de, data, filename)

    return de, data


def write_camera_info_ex(de, data, filename):
    with open(filename, 'w') as wf:
        writer = csv.DictWriter(wf, fieldnames=de)

        writer.writeheader()
        for row in data:
            writer.writerow(row)


