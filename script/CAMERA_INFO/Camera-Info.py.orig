def read_extern_csv(filename, conf):
    with open(filename, "r") as csvfile:
        reader = csv.reader(csvfile)
        next(reader)

        for row in reader:
            sql_row = [
                    row[2], # NAME
                    row[9], # ACTIVE
                    row[3], # Type
                    row[4], # URL
                    row[5], # Address
                    row[6], # Port
                    row[7], # login ID
                    row[8], # login password
                    row[10],# Comment
                ]
            extern_sql_rows.append(sql_row)

def read_broadcast_csv(filename, conf):
    with open(filename, "r") as csvfile:
        reader = csv.reader(csvfile)
        next(reader)

        for row in reader:
            if row[5]:
                row5 = row[5] 
            else:
                row5 = None
            if row[6]:
                row6 = row[6]
            else:
                row6 = None
            sql_row = [
                    row[1].zfill(2), # ID
                    row[2], # Title
                    row[3], # Text
                    row5, #"case when '" + row[5] + "' = '' then null else '" + row[5] + "' end", 
                    row6, #"case when '" + row[6] + "' = '' then null else '" + row[6] + "' end",
                    row[4] # ACTIVE
                ]
            broadcast_sql_rows.append(sql_row)
