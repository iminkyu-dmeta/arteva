def read_cctv_csv_header(filename):
    with open(filename, 'r', encoding='utf-8-sig') as cf:
        reader = csv.reader(cf)
        header = next(reader)

        return header 


def read_cctv_csv_data(filename, conf):
    ## 0.카메라교유번호, 1.역사명, 2.역사아이디, 3.카메라명, 4.카메라아이피, 5. NVR RTSP주소, 6.Port, 7.UUID,
    ## 8.채널번호, 9.ID, 10.PW, 11.TYPE, 12.용도,

    hd = read_cctv_csv_header(filename)
    fd = hd.index('TYPE')
    column_name = hd.index('역사아이디')

    with open(filename, "r") as cf:
        reader = csv.DictReader(cf, fieldnames=hd)
        next(reader)

        for r in reader:
            row_all = {}
            for i, h in enumerate(hd):
                if h:
                    row_all[hd[i]] = r[hd[i]]

            if r[hd[fd]]:
                row = {}
                for i, h in enumerate(hd):
                    if h:
                        row[hd[i]] = r[hd[i]]

                cctv_csv_data.append(row)
            cctv_csv_all_data.append(row_all)
    
    print("Event CCTV Count : %s" % len(cctv_csv_data))

    for sid in STATIONID:
        station = []
        for r in cctv_csv_data:
            if r[hd[column_name]] == sid:
                station.append(r)
        by_data[sid] = station

    return hd


def write_cctv_csv_data(filename, conf, update_rows):
    ## 0.번호, 1.역사명, 2.역사아이디, 3.카메라명, 4.카메라아이피, 5. 'NVR RTSP주소', 6.Port, 7.UUID,
    ## 8.채널번호, 9.ID, 10.PW, 11.TYPE, 12.용도,

    hd = read_cctv_csv_header(filename)

    update_num = []
    update_data = []
    for val in update_rows.values():
        for v in val:
            update_num.append(v[0])

    with open(filename, "r") as cf:
        reader = csv.DictReader(cf, fieldnames=hd)
        next(reader)

        for r in reader:
            num = r['카메라고유번호']
            match_n = [n for n in update_num if n == num ]
            if match_n:
                for value in update_rows.values():
                    for v in value :
                        if v[0] == num: 
                            r['NVR RTSP주소'] = v[1] 
                            update_data.append(r)
            else:
                update_data.append(r)

    write_camera_info_ex(hd, update_data, filename)


def prefare_t_arteva_camera_info(de, data, conf):
    # hostname = "YS-VDOAN-1"
    # hostname = socket.gethostname()
    # stationid = conf[hostname]
    # arteva_camera_info_sql_rows
    # de, data : description, ims_v2 v_camera_info_ex 

    # cctv.csv description
    hd = []
    arteva_camera_info_rows = {}

    for k in cctv_csv_data[0]:
        hd.append(k)

    ## index 
    hd_nu_idx = hd.index('카메라고유번호')
    hd_na_idx = hd.index('역사명')
    hd_si_idx = hd.index('역사아이디')
    hd_ip_idx = hd.index('카메라아이피')
    hd_ca_idx = hd.index('카메라명')
    hd_id_idx = hd.index('ID')
    hd_pw_idx = hd.index('PW')
    hd_ty_idx = hd.index('TYPE')
    hd_us_idx = hd.index('용도')
    de_nu_idx = de.index('카메라고유번호')
    de_cc_idx = de.index('NVR RTSP주소')
    
    # 역별 이벤트 CCTV Dict
    for key, val in by_data.items():
        by_row = []
        num = 1
        for v in val:
            for dt in data:
                if dt[de[de_nu_idx]] == int(v[hd[hd_nu_idx]]):
                    NAME = 'CCTV' + '-' + v[hd[hd_si_idx]] + '-' + str(num).zfill(3)
                    idx = dt[de[de_cc_idx]].find(v[hd[hd_ip_idx]])
                    URL = "rtsp://" + v[hd[hd_id_idx]] + ":" + v[hd[hd_pw_idx]] + '@' + dt[de[de_cc_idx]][idx:]
                    COMMENT = v[hd[hd_na_idx]] + "(" + v[hd[hd_si_idx]] + ") 역사, \
                        카메라 이름: " + v[hd[hd_ca_idx]] + ", \
                        용도: " + v[hd[hd_us_idx]]
                    # change to tuple 
                    event = v[hd[hd_ty_idx]].split(',')
                    event_type = v[hd[hd_ty_idx]]
                    if len(event) == 1:
                        event.append("NE")
                        event_type = ','.join(event)
                        
                    sql_row = [
                        NAME,                   # 1. name(CCTV name)
                        URL,                    # 2. url(rtsp url)
                        conf["ACTIVE"],         # 3. active(Active)
                        conf["RESOLUTION"],     # 4. resolution(FHD)
                        COMMENT,                # 5. comment
                        now,                    # 6. create_time
                        now,                    # 7. update_time
                        conf["adminuser"],      # 8. create_user
                        conf["adminuser"],      # 9. update_user
                        event_type              # 10. event_type
                        ]

                    num+=1

                    by_row.append(sql_row)

        arteva_camera_info_rows[key] = by_row
        
    return arteva_camera_info_rows


